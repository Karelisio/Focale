    <string name="about_offline_title" formatted="false">100% offline</string>
    <string name="about_offline_body">Focale has no account, no analytics and no cloud. Your photos, labels and locations are processed on this device only. The network is only used to check for updates on GitHub (can be turned off) and for the optional OpenStreetMap map background, off by default.</string>
    <string name="about_credits_title">Credits</string>
